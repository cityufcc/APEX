# APEX LAMMPS template: Lat_param_T (finite-T lattice parameters)
# Variables expected from variable_Lat_param_T.in:
#   temperature, nx, ny, nz, equi_step, N_every, N_repeat, N_freq, ave_step
include  variable_Lat_param_T.in
variable temp_init equal 2*${temperature}

clear
units 	metal
dimension	3
boundary	p p p
atom_style	atomic
{{OPTIONAL_PRESET}}box         tilt large
read_data   conf.lmp
replicate   ${nx} ${ny} ${nz}
{{MASS_LINES}}neigh_modify    every 1 delay 0 check no
{{INTERACTION}}compute         mype all pe
thermo          100
thermo_style    custom step pe pxx pyy pzz pxy pxz pyz lx ly lz vol c_mype

# Initial velocities and equilibration
variable temp_init equal 2*${temperature} 

velocity all create ${temp_init} 12345 mom yes rot yes dist gaussian

# Nose-Hoover NPT by default; users can switch via variable file if needed
fix 1 all npt temp ${temperature} ${temperature} 100 iso 0.0 0.0 1000
run ${equi_step}
reset_timestep 0

# Sampling stage
variable lx equal lx
variable ly equal ly
variable lz equal lz
fix 2 all ave/time ${N_every} ${N_repeat} ${N_freq}  v_lx v_ly v_lz  ave running file average_box.txt
run ${ave_step}

# Bookkeeping outputs
variable        N equal step
variable        V equal vol
variable        E equal "c_mype"
variable        tmplx equal lx
variable        tmply equal ly
variable        Pxx equal pxx
variable        Pyy equal pyy
variable        Pzz equal pzz
variable        Pxy equal pxy
variable        Pxz equal pxz
variable        Pyz equal pyz
variable        Epa equal ${E}/${N}
variable        Vpa equal ${V}/${N}
variable        AA equal (${tmplx}*${tmply})
print "All done"
print "Total number of atoms = ${N}"
print "Final energy per atoms = ${Epa}"
print "Final volume per atoms = ${Vpa}"
print "Final Base area = ${AA}"
print "Final Stress (xx yy zz xy xz yz) = ${Pxx} ${Pyy} ${Pzz} ${Pxy} ${Pxz} ${Pyz}"
print "Final Length (box_x box_y box_z) = ${lx} ${ly} ${lz}"
